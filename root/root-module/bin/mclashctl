#!/system/bin/sh
MODDIR=${0%/*}/..
DATA=/data/adb/mclash
CORE="$DATA/bin/mihomo"
CONFIG="$DATA/config/runtime.yaml"
ENV="$DATA/config/root.env"
LOG="$DATA/logs/module.log"
CORE_LOG="$DATA/logs/mihomo.log"
PIDFILE="$DATA/run/mihomo.pid"
STATUS="$DATA/run/status"

log() { mkdir -p "$DATA/logs"; echo "$(date '+%F %T') $*" >> "$LOG"; }
load_env() { [ -r "$ENV" ] && . "$ENV"; PROXY_MODE=${PROXY_MODE:-tun}; }
valid_pid() {
  [ -r "$PIDFILE" ] || return 1
  pid=$(cat "$PIDFILE" 2>/dev/null)
  case "$pid" in ''|*[!0-9]*) return 1;; esac
  [ -r "/proc/$pid/cmdline" ] || return 1
  tr '\000' ' ' < "/proc/$pid/cmdline" | grep -q '/data/adb/mclash/bin/mihomo'
}
cleanup() {
  "$MODDIR/scripts/clear-tproxy.sh" >> "$LOG" 2>&1
  rm -f "$PIDFILE" "$STATUS"
}
start_proxy() {
  load_env
  valid_pid && { echo RUNNING; return 0; }
  cleanup
  [ -x "$CORE" ] || { log "mihomo is missing or not executable"; return 11; }
  [ -s "$CONFIG" ] || { log "runtime.yaml is missing or empty"; return 12; }
  "$CORE" -v >> "$LOG" 2>&1 || { log "mihomo ABI/executable check failed"; return 13; }
  log "starting mihomo in $PROXY_MODE mode"
  nohup "$CORE" -d "$DATA" -f "$CONFIG" >> "$CORE_LOG" 2>&1 &
  pid=$!
  echo "$pid" > "$PIDFILE"
  chmod 0600 "$PIDFILE"
  i=0
  ready=0
  while [ "$i" -lt 30 ]; do
    valid_pid || { log "mihomo exited during startup"; cleanup; return 14; }
    toybox nc -w 1 127.0.0.1 9090 </dev/null >/dev/null 2>&1 && { ready=1; break; }
    sleep 1
    i=$((i + 1))
  done
  [ "$ready" = 1 ] || { log "mihomo controller port did not become ready"; kill "$pid" 2>/dev/null; cleanup; return 16; }
  if [ "$PROXY_MODE" = tproxy ]; then
    "$MODDIR/scripts/apply-tproxy.sh" >> "$LOG" 2>&1 || {
      log "TProxy rule setup failed; cleaning up"
      kill "$pid" 2>/dev/null
      sleep 1
      cleanup
      return 15
    }
  fi
  echo RUNNING > "$STATUS"
  log "mihomo started pid=$pid"
}
stop_proxy() {
  load_env
  if valid_pid; then
    pid=$(cat "$PIDFILE")
    kill "$pid" 2>/dev/null
    i=0
    while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 30 ]; do sleep 1; i=$((i + 1)); done
    kill -9 "$pid" 2>/dev/null
  fi
  cleanup
  log "mihomo stopped and routes cleared"
}
case "${1:-}" in
  start) start_proxy;;
  stop) stop_proxy;;
  restart) stop_proxy; start_proxy;;
  status) valid_pid && echo RUNNING || { echo STOPPED; exit 1; };;
  *) echo "usage: mclashctl {start|stop|restart|status}" >&2; exit 2;;
esac
